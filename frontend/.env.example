# ============================================================
# Moonshot Library 前端环境配置模板
# 复制此文件为 .env.local 并根据环境修改
# ============================================================

# 应用名称
VITE_APP_NAME="Moonshot Library"

# 启用 M365 SSO 登录（true/false）
VITE_ENABLE_M365_SSO=true

# API 基础地址（开发环境通过 Vite 代理，无需配置）
# 生产环境如需配置: VITE_API_BASE_URL=https://your-domain.com/api

# ------------------------------------------------------------
# Microsoft 365 SSO 配置（前端 MSAL）
# 注意：当前使用后端重定向模式，以下配置仅用于 popup 模式
# ------------------------------------------------------------

# Azure AD 客户端 ID
VITE_MSAL_CLIENT_ID=your-azure-client-id

# Azure AD 认证服务器
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/common

# 重定向地址（popup 模式用）
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# 登出后重定向地址
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# OAuth 请求范围
VITE_MSAL_SCOPES=User.Read,email,profile,openid
