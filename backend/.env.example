# ============================================================
# Moonshot Library 后端环境配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ------------------------------------------------------------
# 基础配置
# ------------------------------------------------------------

# 运行环境: development | production | test
NODE_ENV=development

# 服务端口
PORT=3000

# ------------------------------------------------------------
# 前端配置（CORS 和重定向）
# ------------------------------------------------------------

# 前端访问地址（用于 CORS 和 SSO 回调重定向）
# 开发环境: http://localhost:5173
# 生产环境: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# 生产环境允许的域名列表（逗号分隔，用于 CORS）
# ALLOWED_DOMAINS=your-domain.com,api.your-domain.com

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------

# SQLite 数据库路径
DB_PATH=./database/library.db

# ------------------------------------------------------------
# JWT 认证配置
# ------------------------------------------------------------

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-jwt-secret-key-change-in-production

# JWT 过期时间
JWT_EXPIRES_IN=24h

# 刷新令牌密钥
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production

# 刷新令牌过期时间
REFRESH_TOKEN_EXPIRES_IN=7d

# 会话密钥
SESSION_SECRET=your-session-secret-change-in-production

# ------------------------------------------------------------
# Microsoft 365 SSO 配置（可选）
# ------------------------------------------------------------

# Azure AD 应用客户端 ID
MSAL_CLIENT_ID=your-azure-client-id

# Azure AD 应用客户端密钥
MSAL_CLIENT_SECRET=your-azure-client-secret

# Azure AD 认证服务器
MSAL_AUTHORITY=https://login.microsoftonline.com/common

# OAuth 回调地址（必须与 Azure 门户配置一致）
MSAL_REDIRECT_URI=http://localhost:3000/api/auth/msal/callback

# 登出后重定向地址
MSAL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# OAuth 请求范围
MSAL_SCOPES=user.read,email,profile,openid

# ------------------------------------------------------------
# 借阅规则配置
# ------------------------------------------------------------

BORROWING_PERIOD_DAYS=21
RENEWAL_PERIOD_DAYS=14
MAX_RENEWALS=2

# ------------------------------------------------------------
# 限流配置
# ------------------------------------------------------------

# 通用 API 限流（单位：毫秒）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# 认证相关限流（建议按账号/邮箱限制）
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ------------------------------------------------------------
# 其他配置
# ------------------------------------------------------------

MAX_FILE_SIZE=5242880
LOG_LEVEL=info
