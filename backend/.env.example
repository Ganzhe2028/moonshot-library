PORT=3000
NODE_ENV=development

# 数据库配置
DB_PATH=./database/library.db

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key
REFRESH_TOKEN_EXPIRES_IN=14d

# 会话配置
SESSION_SECRET=your-session-secret-key

# 前端URL
FRONTEND_URL=http://localhost:5173

# 借阅配置
BORROW_PERIOD_DAYS=21
RENEW_PERIOD_DAYS=14
MAX_RENEWALS=2

# 文件上传配置
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Microsoft OAuth配置 (M365 SSO)
MSAL_CLIENT_ID=MSAL_CLIENT_ID
MSAL_CLIENT_SECRET=CLIENT_SECRET
MSAL_TENANT_ID=TENANT_ID
MSAL_AUTHORITY=https://login.microsoftonline.com/common
MSAL_REDIRECT_URI=http://localhost:3000/api/auth/msal/callback
MSAL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
MSAL_SCOPES=User.Read,email,profile,openid